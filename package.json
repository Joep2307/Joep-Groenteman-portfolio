{
    "name": "joep-groenteman-portfolio",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "pnpm wasm && vite",
        "build": "pnpm wasm && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "pnpm lint:ts && pnpm lint:scss && pnpm lint:rust",
        "lint:ts": "eslint .",
        "lint:scss": "stylelint \"src/**/*.scss\" --allow-empty-input",
        "lint:rust": "cargo clippy --manifest-path src/geometry/Cargo.toml --all-targets -- -D warnings",
        "format": "prettier --write . && cargo fmt --manifest-path src/geometry/Cargo.toml",
        "format:check": "prettier --check . && cargo fmt --manifest-path src/geometry/Cargo.toml --check",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:rust": "cargo test --manifest-path src/geometry/Cargo.toml",
        "smoke": "playwright test --project=smoke",
        "baseline:capture": "BASE_URL=https://joep-groenteman-portfolio-qwc2.vercel.app playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
        "baseline:compare": "playwright test --project=visual-desktop --project=visual-mobile",
        "wasm": "PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" wasm-pack build src/geometry --target bundler --release",
        "prepare": "husky"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@typescript-eslint/utils": "^8.72.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "sass-embedded": "^1.107.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "^5.1.0"
    }
}
